# =============================================================================
#  Quay — MAINNET (Stellar public network) configuration template
# =============================================================================
#
#  Copy to .env and fill in every <PLACEHOLDER>. Do not commit the result.
#
#  This file lists only what differs from .env.example, plus everything the
#  public-network guardrails in apps/api/src/env.ts make mandatory. Those
#  guards throw at boot rather than warn: a process that refuses to start is
#  loud, a process that quietly settles into a sandbox anchor is not.
#
#  Cutover procedure, verification steps, and rollback: docs/MAINNET.md
#
# -----------------------------------------------------------------------------

# ---- Network ----------------------------------------------------------------
STELLAR_NETWORK=public
# Defaults to https://horizon.stellar.org when unset. Set both if you use a
# paid/self-hosted Horizon — the free SDF instance is rate-limited and is not
# an appropriate primary for production payment watching.
# HORIZON_URL=https://horizon.stellar.org
# HORIZON_URL_FALLBACK=

# Circle's USDC issuer on pubnet. VERIFY this against Circle's own published
# address before taking a single real payment — an attacker-issued asset with
# the code "USDC" is trivial to create and is worth nothing.
#   https://developers.circle.com/stablecoins/stellar-usdc
USDC_ISSUER_PUBLIC=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# ---- Off-ramp ---------------------------------------------------------------
# "anchor" and "none" are the only settings that boot on public. mock and
# testanchor are refused at startup: neither moves real money, and both would
# show sellers a completed cash-out that never happened.
#
#   none   - PAYMENTS ONLY. No cash-out leg. Buyers pay the seller's wallet
#            directly, the watcher confirms it, the seller moves their own
#            funds. This needs no anchor agreement, stores no SEP-12 identity
#            data, and requires NO DEFAULT_SELLER_SECRET — with no off-ramp the
#            server holds no key that can spend a seller's funds at all. It is
#            the fastest and lowest-risk route to a live mainnet deployment.
#            If you use it: leave ANCHOR_URL, ANCHOR_HOME_DOMAIN,
#            KYC_ENCRYPTION_KEY and DEFAULT_SELLER_SECRET unset below, and set
#            NEXT_PUBLIC_OFFRAMP_MODE=none on the web app.
#
#   anchor - full cash-out to fiat through a production anchor. Requires the
#            two ANCHOR_ variables, KYC_ENCRYPTION_KEY, DEFAULT_SELLER_SECRET,
#            and a commercial agreement with the anchor.
OFFRAMP=anchor
ANCHOR_URL=https://<YOUR-ANCHOR-DOMAIN>
ANCHOR_HOME_DOMAIN=<YOUR-ANCHOR-DOMAIN>
# Set once you know which rail the anchor should use. Unset means "read
# /sep6/info and refuse if the anchor offers more than one type".
# OFFRAMP_TYPE=bank_account

# ---- Identity and secrets ---------------------------------------------------
# All four are REQUIRED on public. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# except SERVER_SIGNING_SECRET / DEFAULT_SELLER_SECRET, which are Stellar
# S... keys. Store them in your platform's secret manager, never in git.

# Seller wallet that receives funds. Always required on public.
DEFAULT_SELLER_WALLET=<G...>
# The matching secret. Required ONLY for OFFRAMP=anchor, where SEP-10 auth must
# be signed with it. Leave it unset entirely when OFFRAMP=none — a key the
# server does not hold cannot be stolen from the server.
DEFAULT_SELLER_SECRET=<S...>

# The platform's own SEP-10 signing identity, published as SIGNING_KEY in
# /.well-known/stellar.toml. MUST be stable across restarts — if this rotates,
# every wallet that cached the old key fails to log in. This same identity is
# the on-chain attester, so it must hold XLM to pay invocation fees.
SERVER_SIGNING_SECRET=<S...>

# Signs session JWTs. Auto-generated per boot when unset, which logs every
# seller out on each deploy.
JWT_SECRET=<64 hex chars>

# Encrypts seller SEP-12 KYC field values at rest. Required for OFFRAMP=anchor
# — this is real PII on mainnet. Not needed when OFFRAMP=none, which collects
# no identity data at all.
KYC_ENCRYPTION_KEY=<64 hex chars>

# Encrypts webhook signing secrets at rest. Without it the process falls back
# to a hardcoded public dev key, and anyone with the repo could decrypt stored
# secrets and forge delivery signatures.
WEBHOOK_SECRET_ENCRYPTION_KEY=<64 hex chars>

# ---- Database ---------------------------------------------------------------
# A real, backed-up database. `file:./local.db` on a container filesystem is
# lost on every redeploy, taking the payment ledger with it.
DATABASE_URL=<libsql://...>
DATABASE_AUTH_TOKEN=<token>

# ---- Soroban attestation ----------------------------------------------------
# Optional but not defaulted on public: leaving SOROBAN_RPC_URL unset there is
# deliberate, so nothing silently attests to the testnet contract. Both must be
# set together, and ATTESTATION_CONTRACT_ID must be a PUBNET deployment — the
# testnet contract id will not resolve here.
# ATTESTATION_CONTRACT_ID=<pubnet C... contract id>
# SOROBAN_RPC_URL=https://soroban-rpc.mainnet.stellar.gateway.fm

# ---- Serving ----------------------------------------------------------------
# Comma-separated. Must be the real production origins — no localhost.
CORS_ORIGINS=https://<your-web-domain>
# Only set if a custom domain or proxy sits in front of the API. Render
# otherwise supplies RENDER_EXTERNAL_HOSTNAME and this stays unset.
# HOME_DOMAIN=<api.your-domain>
# Reverse-proxy hops in front of this instance; determines which
# x-forwarded-for entry is trusted as the client IP for rate limiting.
# Defaults to 1 on public (one platform edge proxy).
# TRUST_PROXY_HOPS=1
# Shared rate-limit counters across instances. Strongly recommended once you
# run more than one — the in-process Map means N instances allow N times the
# configured limit.
# REDIS_URL=

# Bearer token for GET /metrics. Auto-generates an ephemeral one when unset,
# which breaks any scraper across restarts.
METRICS_TOKEN=<64 hex chars>

# ---- Web --------------------------------------------------------------------
# Every NEXT_PUBLIC_* value below is baked into the client bundle AT BUILD
# TIME - changing one and redeploying without rebuilding does nothing; the
# old value is still what ships in the bundle a visitor's browser downloads.
#
# MUST match STELLAR_NETWORK above. The browser signs with the passphrase this
# selects; a mismatch means every wallet signature is rejected by the network
# the API is watching, with no error that names the cause.
NEXT_PUBLIC_STELLAR_NETWORK=public
# Leaving this unset on a production build has actually broken production
# before (docs/FIXLOG.md, BUG-1.4): the code's local-dev localhost fallback
# got baked into the deployed bundle, so every visitor's browser silently
# tried to reach localhost on their OWN machine. A production build with
# this unset now fails loudly in the browser instead - set it and rebuild.
NEXT_PUBLIC_API_URL=https://<api.your-domain>
API_URL=https://<api.your-domain>
# Must mirror OFFRAMP above. "none" hides the cash-out button, the KYC panel
# and the cash-out modal; the API answers 501 on those routes either way.
NEXT_PUBLIC_OFFRAMP_MODE=anchor
# Only meaningful when the off-ramp is enabled.
NEXT_PUBLIC_OFFRAMP_CURRENCY=<currency your anchor actually quotes>
